<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <EditText
        android:id="@+id/terminal_toolbar_text_input"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:imeOptions="flagNoFullscreen"
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:maxLines="8"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@android:color/white"
        android:textColorHighlight="@android:color/darker_gray"
        android:textCursorDrawable="@null"
        tools:ignore="LabelFor" />

    <!-- Sends the composed text to the terminal. Kept as a real button because the
         field is multi-line, so the IME Enter key inserts a newline instead of
         submitting. -->
    <ImageButton
        android:id="@+id/terminal_toolbar_text_send"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/action_send"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_send"
        android:tint="@android:color/white" />

</LinearLayout>
